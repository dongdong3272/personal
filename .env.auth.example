# Copy to .env.auth and fill in. Never commit .env.auth.
# Then run: npm run auth:hash

# 任意一长串随机字符即可（建议 32+ 位字母数字），自己编或 PowerShell: -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 48|%{[char]$_})
AUTH_PEPPER=some-random-string
# Month-day only (MM-DD or M-D); old YYYY-MM-DD in .env still works when hashing
AUTH_BIRTHDAY=07-22
AUTH_HOMETOWN=your-hometown-normalized-text
AUTH_MOVIE_OPTION_ID=xxxx
AUTH_GAME_OPTION_ID=xxxx